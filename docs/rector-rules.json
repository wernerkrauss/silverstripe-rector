        {
            "name": "ListFilterToArrayRector",
            "class": "Netwerkstatt\\SilverstripeRector\\Rector\\ORM\\ListFilterToArrayRector",
            "category": "Code Style",
            "silverstripe_version_mentioned": null,
            "set_versions": [],
            "description": "Code Style: Translates Silverstripe ORM filter() and similar calls from string notation to array notation.",
            "file": "src/Rector/ORM/ListFilterToArrayRector.php",
            "configurable": false,
            "sets": [
                "CODE_STYLE"
            ],
            "examples": [
                {
                    "before": "$list->filter('key', 'value');\n$list->exclude('key', 'value');\n$list->filterAny('key', 'value');\n$list->excludeAny('key', 'value');",
                    "after": "$list->filter(['key' => 'value']);\n$list->exclude(['key' => 'value']);\n$list->filterAny(['key' => 'value']);\n$list->excludeAny(['key' => 'value']);",
