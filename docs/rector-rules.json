        {
            "name": "AddConfigPropertiesRector",
            "class": "Netwerkstatt\\SilverstripeRector\\Rector\\Misc\\AddConfigPropertiesRector",
            "category": "Code Style",
            "silverstripe_version_mentioned": null,
            "set_versions": [],
            "description": "Code Style: Adds @config property to predefined private statics, e.g. $db or $allowed_actions",
            "file": "src/Rector/Misc/AddConfigPropertiesRector.php",
            "configurable": true,
            "sets": [],
            "examples": [
                {
                    "before": "class SomeClass extends \\SilverStripe\\ORM\\DataObject\n{\n    private static $db = [];\n}",
                    "after": "class SomeClass extends \\SilverStripe\\ORM\\DataObject\n{\n    /**\n    * @config\n    */\n    private static $db = [];\n}",
                    "requires_configuration": false
                }
            ]
        },
        {
            "name": "BuildTaskUpdateRector",
            "class": "Netwerkstatt\\SilverstripeRector\\Rector\\Misc\\BuildTaskUpdateRector",
            "category": "Silverstripe",
            "silverstripe_version_mentioned": "6.0",
            "set_versions": [
                "6.0"
            ],
            "description": "Silverstripe 6.0: Updates Silverstripe BuildTask from v5 to v6",
            "file": "src/Rector/Misc/BuildTaskUpdateRector.php",
            "configurable": false,
            "sets": [
                "SS_6_0"
            ],
            "examples": [
                {
                    "before": "use SilverStripe\\Dev\\BuildTask;\n\nclass MyTask extends BuildTask\n{\n    protected $title = 'My Task';\n\n    public function run($request)\n    {\n        echo \"Running task\";\n    }\n}",
                    "after": "use SilverStripe\\Dev\\BuildTask;\nuse Symfony\\Component\\Console\\Input\\InputInterface;\nuse SilverStripe\\PolyExecution\\PolyOutput;\n\nclass MyTask extends BuildTask\n{\n    protected string $title = 'My Task';\n\n    protected function execute(InputInterface $input, PolyOutput $output): int\n    {\n        $output->writeln('Running task');\n        return \\Symfony\\Component\\Console\\Command\\Command::SUCCESS;\n    }\n}",
                    "requires_configuration": false
                }
            ]
        },
