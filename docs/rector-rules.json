            ],
            "description": "Silverstripe 6.0: Convert Form::validate() boolean usage to isValid().",
            "file": "src/Rector/Forms/FormValidateToIsValidRector.php",
            "configurable": false,
            "sets": [
                "SS_5_4"
            ],
            "examples": [
                {
                    "before": "use SilverStripe\\Forms\\Form;\n\nfunction check(Form $form, bool $other): bool\n{\n    if ($form->validate()) {\n        return true;\n    }\n\n    return $form->validate() && $other;\n}",
