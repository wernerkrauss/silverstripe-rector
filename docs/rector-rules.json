        {
            "name": "DataObjectStaticMethodsToFluentRector",
            "class": "Netwerkstatt\\SilverstripeRector\\Rector\\DataObject\\DataObjectStaticMethodsToFluentRector",
            "category": "Silverstripe",
            "silverstripe_version_mentioned": "6.1",
            "set_versions": [
                "6.1"
            ],
            "description": "Silverstripe 6.1: Replace DataObject static methods get_by_id(), get_one(), and delete_by_id() with fluent equivalents.",
            "file": "src/Rector/DataObject/DataObjectStaticMethodsToFluentRector.php",
            "configurable": false,
            "sets": [
                "SS_6_1"
            ],
            "examples": [
                {
                    "before": "DataObject::get_by_id($className, $id);\nDataObject::get_one($className, $filter);\nDataObject::delete_by_id($className, $id);",
                    "after": "DataObject::get($className)->setUseCache(true)->byID($id);\nDataObject::get($className)->setUseCache(true)->filter($filter)->first();\nDataObject::get($className)->setUseCache(true)->byID($id)->delete();",
                    "requires_configuration": false
                }
            ]
