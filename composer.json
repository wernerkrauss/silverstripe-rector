{
  "name": "wernerkrauss/silverstripe-rector",
  "description": "Rector rules for Silverstripe CMS",
  "type": "rector-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Werner Krauß",
      "email": "werner.krauss@netwerkstatt.at"
    }
  ],
  "require": {
    "php": "^7.4 | ^8",
    "rector/rector": "^2.3.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "squizlabs/php_codesniffer": "^4",
    "phpstan/phpstan": "^2",
    "rector/swiss-knife": "^2.4",
    "symplify/rule-doc-generator": "^12.1"
  },
  "autoload": {
    "psr-4": {
      "Netwerkstatt\\SilverstripeRector\\": "src/",
      "Rector\\":"rules"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Netwerkstatt\\SilverstripeRector\\Tests\\": "tests"
    },
    "classmap": ["stubs"],
    "exclude-from-classmap": [
      "**.php.inc"
    ]
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "lint": "@php vendor/bin/phpcs",
    "fix": "@php vendor/bin/phpcbf",
    "stan": "@php vendor/bin/phpstan",
    "rector": "@php vendor/bin/rector",
    "rector:dry": "@php vendor/bin/rector --dry-run --no-ansi",
    "ci": "composer test && composer lint && composer rector:dry && composer stan",
    "docs:generate": "vendor/bin/rule-doc-generator generate src --output-file docs/all_rectors_overview.md --ansi --categorize 2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
